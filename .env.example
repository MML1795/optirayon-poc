# ═══════════════════════════════════════════════════════════════════════════════
# .env.example — Template des variables d'environnement
# ⚠️  NE JAMAIS COMMITTER LE FICHIER .env (ajouté au .gitignore)
# Copier ce fichier en .env et remplir les valeurs réelles
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Sécurité Flask ───────────────────────────────────────────────────────────
# Clé secrète Flask (générer avec : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_DE_64_CARACTERES

# ─── Environnement ────────────────────────────────────────────────────────────
FLASK_ENV=development        # development | production
FLASK_DEBUG=0                # 1 en dev, 0 en production

# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/nondetention.db
# Pour PostgreSQL en production :
# DATABASE_URL=postgresql://user:password@localhost:5432/nondetention_db

# Identifiants base de données SQL (si PostgreSQL)
DB_USER=nondetention_user
DB_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_DB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nondetention_db

# ─── Identifiants administrateur (back-office) ────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_ADMIN
ADMIN_EMAIL=admin@syraliyacom.fr

# ─── Identifiants de test ─────────────────────────────────────────────────────
# Ces identifiants ne sont utilisés qu'en environnement de test
TEST_USER_VIEWER=viewer
TEST_PASSWORD_VIEWER=REMPLACER_PAR_MOT_DE_PASSE_VIEWER
TEST_USER_RAYON=rayon_liquides
TEST_PASSWORD_RAYON=REMPLACER_PAR_MOT_DE_PASSE_RAYON

# ─── Chemins des fichiers modèle ──────────────────────────────────────────────
MODEL_LASSO_PATH=models/model_lasso.pkl
SCALER_PATH=models/scaler.pkl

# ─── Configuration serveur ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=5000
APP_URL=http://syraliyacom-nondetention.local:5000

# ─── Journalisation ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
